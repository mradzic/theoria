---
interface Props {
  lang?: "sr" | "en";
}

const { lang = "sr" } = Astro.props;

const heading =
  lang === "en"
    ? "INDEXING & AVAILABILITY"
    : "INDEKSIRANJE I DOSTUPNOST";

const services = [
  {
    name: "The Philosopher’s Index",
    description:
      lang === "en"
        ? "International bibliography of philosophy"
        : "Međunarodna bibliografija filozofije",
    href: "https://philindex.org/",
  },
  {
    name: "ERIH PLUS",
    description:
      lang === "en"
        ? "European Reference Index for the Humanities and Social Sciences"
        : "Evropski referentni indeks za humanističke i društvene nauke",
    href: "https://erihplus.hkdir.no/journal?id=509782",
  },
  {
  name: "Dimensions",
  description:
    lang === "en"
      ? "International research and citation database"
      : "Međunarodna istraživačka i citatna baza",
  href: "https://app.dimensions.ai/",
},
  {
    name: "CEEOL",
    description:
      lang === "en"
        ? "Central and Eastern European Online Library"
        : "Central and Eastern European Online Library",
    href: "https://www.ceeol.com/search/journal-detail?id=4188",
  },
  {
    name: "doiSerbia",
    description:
      lang === "en"
        ? "DOI and full-text service"
        : "DOI i servis punog teksta",
    href: "https://doiserbia.nb.rs/journal.aspx?issn=0351-2274",
  },
];
---

<section class="indexing" aria-labelledby="indexing-title">
  <div class="indexing-heading">
    <p class="indexing-label" id="indexing-title">{heading}</p>
  </div>

  <div class="indexing-grid">
    {
      services.map((service) => (
        <a
          class="indexing-item"
          href={service.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="indexing-top">
            <span class="indexing-name">{service.name}</span>
            <span class="indexing-arrow" aria-hidden="true">↗</span>
          </span>

          <span class="indexing-description">
            {service.description}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .indexing {
    border-top: 1px solid var(--rule);
    padding-bottom: 84px;
  }

  .indexing-heading {
    padding: 22px 0 20px;
    border-bottom: 1px solid var(--rule);
  }

  .indexing-label {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.17em;
  }

  .indexing-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .indexing-item {
    display: flex;
    min-width: 0;
    min-height: 155px;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 28px 20px;
    border-right: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .indexing-item:first-child {
    padding-left: 0;
  }

  .indexing-item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .indexing-item:hover {
    opacity: 0.58;
  }

  .indexing-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .indexing-name {
    font-size: clamp(1.08rem, 1.45vw, 1.45rem);
    line-height: 1.08;
  }

  .indexing-arrow {
    flex: 0 0 auto;
    font-family: var(--sans);
    font-size: 0.8rem;
    opacity: 0.45;
  }

  .indexing-description {
    max-width: 210px;
    font-family: var(--sans);
    font-size: 0.68rem;
    line-height: 1.45;
    opacity: 0.58;
  }

  @media (max-width: 1000px) {
    .indexing-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .indexing-item:nth-child(3) {
      border-right: 0;
      padding-right: 0;
    }

    .indexing-item:nth-child(4),
    .indexing-item:nth-child(5) {
      border-top: 1px solid var(--rule);
    }

    .indexing-item:nth-child(4) {
      padding-left: 0;
    }
  }

  @media (max-width: 650px) {
    .indexing {
      padding-bottom: 64px;
    }

    .indexing-grid {
      grid-template-columns: 1fr;
    }

    .indexing-item,
    .indexing-item:first-child,
    .indexing-item:last-child {
      min-height: auto;
      padding: 24px 0;
      border-right: 0;
      border-top: 1px solid var(--rule);
    }

    .indexing-item:first-child {
      border-top: 0;
    }

    .indexing-description {
      max-width: 300px;
    }
  }
</style>
