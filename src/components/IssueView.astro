---
import BaseLayout from "../layouts/BaseLayout.astro";

const { issue, lang = "sr" } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const isEnglish = lang === "en";

const ui = isEnglish
	? {
			description:
				"journal of the Serbian Philosophical Society",
			intro:
				"journal of the Serbian Philosophical Society.",
			fullPdf: "Full issue · PDF ↗",
			source: "DOI Serbia · issue ↗",
			introduction: "INTRODUCTION",
			archive: "← Archive",
		}
	: {
			description:
				"časopis Srpskog filozofskog društva",
			intro:
				"časopis Srpskog filozofskog društva.",
			fullPdf: "Ceo broj · PDF ↗",
			source: "DOI Serbia · broj ↗",
			introduction: "UVOD",
			archive: "← Arhiva",
		};

const archiveHref = isEnglish
	? `${base}en/archive/`
	: `${base}arhiva/`;

const sectionTitle = (title) => {
	if (!isEnglish) return title;

	const translations = {
		"Članci": "Articles",
		"ČLANCI": "ARTICLES",
		"Uvod": "Introduction",
		"UVOD": "INTRODUCTION",
	};

	return translations[title] ?? title;
};
---

<BaseLayout
	title={`${issue.label} — Theoria`}
	description={`Theoria ${issue.label} — ${ui.description}`}
	lang={lang}
>
	<main class="container">
		<section class="issue-heading">
			<div class="heading-meta">
				<p class="label">THEORIA</p>
				<p class="heading-year">{issue.year}</p>
			</div>

			<div class="issue-title">
				<div class="issue-identity">
					<h1>
						<span class="volume">Vol. {issue.volume}</span>
						<span class="number">No. {issue.number}</span>
					</h1>
				</div>

				<div class="issue-access">
					{
						issue.pdf ? (
							<a
								class="issue-link"
								href={issue.pdf}
								target="_blank"
								rel="noopener noreferrer"
							>
								{ui.fullPdf}
							</a>
						) : issue.source ? (
							<a
								class="issue-link"
								href={issue.source}
								target="_blank"
								rel="noopener noreferrer"
							>
								{ui.source}
							</a>
						) : null
					}
				</div>
			</div>

			<p class="intro">
				<em>Theoria</em>, {ui.intro}
			</p>
		</section>

		{
			issue.editorial && (
				<section class="editorial">
					<div class="section-heading">
						<p class="label">
							{ui.introduction}
						</p>
					</div>

					<div class="editorial-row">
						<div class="editorial-main">
							<h2>
								{issue.editorial.title}
							</h2>

							<p class="authors">
								{issue.editorial.authors.join(" · ")}
							</p>
						</div>

						<p class="pages">
							{issue.editorial.pages}
						</p>
					</div>
				</section>
			)
		}

		{
			issue.sections.map((section) => (
				<section class="contents">
					<div class="section-heading">
						<h2 class="section-title">
							{sectionTitle(section.title)}
						</h2>
					</div>

					<ol>
						{section.articles.map((article) => (
							<li>
								<article class="article">
									<div class="article-main">
										<h3>
											{article.title}
										</h3>

										<p class="authors">
											{article.authors.join(" · ")}
										</p>
									</div>

									<div class="article-meta">
										<p class="article-pages">
											{article.pages}
										</p>

										{
											article.doi && (
												<a
													href={article.doi}
													target="_blank"
													rel="noopener noreferrer"
												>
													DOI ↗
												</a>
											)
										}
									</div>
								</article>
							</li>
						))}
					</ol>
				</section>
			))
		}

		<div class="back">
			<a href={archiveHref}>
				{ui.archive}
			</a>
		</div>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(
			var(--page-width),
			calc(100% - var(--page-padding))
		);
		margin-inline: auto;
	}

	/* ISSUE HEADING */

	.issue-heading {
		padding: 72px 0 68px;
		border-bottom: 1px solid var(--rule);
	}

	.heading-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;

		padding-bottom: 20px;
		margin-bottom: 42px;

		border-bottom: 1px solid var(--rule);
	}

	.label,
	.heading-year {
		margin: 0;

		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.17em;
	}

	.heading-year {
		letter-spacing: 0.12em;
	}

	.issue-title {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			minmax(210px, auto);

		align-items: end;
		gap: 60px;
	}

	.issue-heading h1 {
		margin: 0;

		font-weight: 400;
		line-height: 0.9;

		font-variant-numeric: lining-nums;
	}

	.volume {
		display: block;

		font-size: clamp(4.3rem, 8vw, 7.4rem);
		letter-spacing: -0.045em;
	}

	.number {
		display: block;

		margin-top: 23px;

		font-size: clamp(1.75rem, 3vw, 2.55rem);
		line-height: 1;

		letter-spacing: -0.02em;
	}

	.issue-access {
		align-self: end;
		padding-bottom: 4px;
	}

	.issue-link {
		display: inline-block;

		padding-bottom: 5px;

		border-bottom: 1px solid currentColor;

		color: inherit;
		text-decoration: none;

		font-family: var(--sans);
		font-size: 0.77rem;
		font-weight: 700;
		line-height: 1.2;

		letter-spacing: 0.065em;
		text-transform: uppercase;
	}

	.issue-link:hover {
		opacity: 0.58;
	}

	.intro {
		max-width: 610px;

		margin: 42px 0 0;

		font-size: 1.16rem;
		line-height: 1.55;
	}

	/* SHARED SECTION HEADING */

	.section-heading {
		padding-bottom: 16px;

		border-bottom: 1px solid var(--rule);
	}

	.section-title {
		margin: 0;

		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.17em;
		text-transform: uppercase;
	}

	/* EDITORIAL */

	.editorial {
		padding-top: 52px;
	}

	.editorial-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 120px;
		gap: 50px;

		padding: 30px 0 34px;

		border-bottom: 1px solid var(--rule-light);
	}

	.editorial-main {
		max-width: 800px;
	}

	.editorial h2 {
		margin: 0;

		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 400;
		line-height: 1.28;

		letter-spacing: -0.012em;
	}

	.authors {
		margin: 11px 0 0;

		color: var(--muted);

		font-size: 0.98rem;
		line-height: 1.45;
	}

	.pages {
		margin: 4px 0 0;

		font-family: var(--sans);
		font-size: 0.75rem;
		line-height: 1.4;

		text-align: right;
	}

	/* CONTENTS */

	.contents {
		padding-top: 62px;
	}

	ol {
		list-style: none;

		margin: 0;
		padding: 0;
	}

	li {
		border-bottom: 1px solid var(--rule-light);
	}

	.article {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 135px;

		gap: 55px;

		padding: 29px 0 30px;
	}

	.article-main {
		max-width: 850px;
	}

	.article h3 {
		margin: 0;

		font-size: clamp(1.3rem, 2vw, 1.6rem);
		font-weight: 400;
		line-height: 1.3;

		letter-spacing: -0.01em;
	}

	.article-meta {
		padding-top: 3px;

		font-family: var(--sans);
		font-size: 0.75rem;
		line-height: 1.4;

		text-align: right;
	}

	.article-pages {
		margin: 0 0 12px;

		color: var(--muted);

		font-variant-numeric: tabular-nums;
	}

	.article-meta a {
		display: inline-block;

		padding-bottom: 2px;

		border-bottom: 1px solid currentColor;

		color: inherit;
		text-decoration: none;

		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.article-meta a:hover {
		opacity: 0.58;
	}

	/* BACK */

	.back {
		padding: 65px 0 85px;

		font-family: var(--sans);
		font-size: 0.76rem;
		font-weight: 700;

		letter-spacing: 0.055em;
		text-transform: uppercase;
	}

	.back a {
		padding-bottom: 4px;

		border-bottom: 1px solid transparent;

		color: inherit;
		text-decoration: none;
	}

	.back a:hover {
		border-bottom-color: currentColor;
	}

	/* TABLET */

	@media (max-width: 800px) {
		.issue-heading {
			padding: 58px 0 55px;
		}

		.heading-meta {
			margin-bottom: 34px;
		}

		.issue-title {
			grid-template-columns: 1fr;
			gap: 34px;
		}

		.issue-access {
			padding-bottom: 0;
		}

		.editorial-row,
		.article {
			grid-template-columns: minmax(0, 1fr) 100px;
			gap: 35px;
		}
	}

	/* MOBILE */

	@media (max-width: 620px) {
		.issue-heading {
			padding: 46px 0 48px;
		}

		.heading-meta {
			padding-bottom: 17px;
			margin-bottom: 30px;
		}

		.volume {
			font-size: clamp(4rem, 19vw, 5.6rem);
		}

		.number {
			margin-top: 18px;
		}

		.intro {
			margin-top: 34px;

			font-size: 1.08rem;
		}

		.editorial,
		.contents {
			padding-top: 48px;
		}

		.editorial-row,
		.article {
			grid-template-columns: 1fr;
			gap: 18px;
		}

		.editorial-row {
			padding: 25px 0 28px;
		}

		.article {
			padding: 25px 0 27px;
		}

		.pages,
		.article-meta {
			text-align: left;
		}

		.pages {
			margin-top: 0;
		}

		.article-pages {
			display: inline;
			margin-right: 18px;
		}

		.article-meta a {
			margin-left: 0;
		}

		.back {
			padding: 55px 0 70px;
		}
	}
</style>