---
import BaseLayout from "../layouts/BaseLayout.astro";

const { issue } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title={`${issue.label} — Theoria`}
	description={`Theoria ${issue.label} — časopis Srpskog filozofskog društva`}
>
	<main class="container">
		<section class="issue-heading">
			<p class="label">THEORIA</p>

			<div class="issue-title">
				<div>
					<h1>Vol. {issue.volume}, No. {issue.number}</h1>
					<p class="year">{issue.year}</p>
				</div>

				<a
					class="pdf-button"
					href={issue.pdf}
					target="_blank"
					rel="noopener noreferrer"
				>
					Ceo broj · PDF ↗
				</a>
			</div>

			<p class="intro">
				<em>Theoria</em>, časopis Srpskog filozofskog društva.
			</p>
		</section>

		{
			issue.editorial && (
				<section class="editorial">
					<p class="label">UVOD</p>

					<div class="editorial-row">
						<div>
							<h2>{issue.editorial.title}</h2>
							<p>{issue.editorial.authors.join(" · ")}</p>
						</div>

						<p class="pages">{issue.editorial.pages}</p>
					</div>
				</section>
			)
		}

		{
			issue.sections.map((section) => (
				<section class="contents">
					<h2 class="section-title">{section.title}</h2>

					<ol>
						{section.articles.map((article) => (
							<li>
								<div class="article">
									<div class="article-main">
										<h3>{article.title}</h3>

										<p class="authors">
											{article.authors.join(" · ")}
										</p>
									</div>

									<div class="article-meta">
										<p>{article.pages}</p>

										{
											article.doi && (
												<a
													href={article.doi}
													target="_blank"
													rel="noopener noreferrer"
												>
													DOI ↗
												</a>
											)
										}
									</div>
								</div>
							</li>
						))}
					</ol>
				</section>
			))
		}

		<div class="back">
			<a href={`${base}arhiva/`}>← Arhiva</a>
		</div>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.issue-heading {
		padding: 90px 0 70px;
		border-bottom: 1px solid #bcb7ac;
	}

	.label {
		margin: 0 0 24px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	.issue-title {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.issue-heading h1 {
		margin: 0;
		font-size: clamp(3.5rem, 8vw, 6.5rem);
		line-height: 0.95;
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.year {
		margin: 12px 0 0;
		font-size: 2rem;
	}

	.intro {
		margin: 35px 0 0;
		font-size: 1.25rem;
	}

	.pdf-button {
		flex: 0 0 auto;
		padding: 13px 17px;
		border: 1px solid #181818;
		color: inherit;
		text-decoration: none;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.8rem;
	}

	.pdf-button:hover {
		background: #181818;
		color: #f5f2eb;
	}

	.editorial {
		padding: 55px 0;
		border-bottom: 1px solid #bcb7ac;
	}

	.editorial-row {
		display: flex;
		justify-content: space-between;
		gap: 40px;
	}

	.editorial h2 {
		margin: 0;
		font-size: 1.8rem;
		font-weight: 400;
	}

	.editorial p {
		margin: 8px 0 0;
	}

	.pages {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.8rem;
	}

	.contents {
		padding-top: 65px;
	}

	.section-title {
		margin: 0 0 24px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.82rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		border-top: 1px solid #c9c4ba;
	}

	li:last-child {
		border-bottom: 1px solid #c9c4ba;
	}

	.article {
		display: grid;
		grid-template-columns: 1fr 140px;
		gap: 50px;
		padding: 28px 0;
	}

	.article h3 {
		margin: 0;
		max-width: 800px;
		font-size: 1.45rem;
		line-height: 1.3;
		font-weight: 400;
	}

	.authors {
		margin: 10px 0 0;
		font-size: 1rem;
	}

	.article-meta {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.78rem;
		text-align: right;
	}

	.article-meta p {
		margin: 3px 0 12px;
	}

	.article-meta a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid #181818;
	}

	.back {
		padding: 60px 0 90px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	.back a {
		color: inherit;
		text-decoration: none;
	}

	.back a:hover {
		text-decoration: underline;
	}

	@media (max-width: 800px) {
		.issue-title {
			align-items: flex-start;
			flex-direction: column;
		}

		.issue-heading {
			padding: 60px 0 50px;
		}

		.editorial-row {
			flex-direction: column;
			gap: 10px;
		}

		.article {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.article-meta {
			text-align: left;
		}
	}
</style>