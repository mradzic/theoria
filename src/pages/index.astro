---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title="Theoria — Srpsko filozofsko društvo"
	description="Theoria — časopis Srpskog filozofskog društva"
>
	<main class="container">
		<section class="intro">
			<p class="label">THEORIA · BEOGRAD</p>

			<h1>
				Filozofski časopis<br />
				Srpskog filozofskog<br />
				društva
			</h1>

			<p class="lead">
				Theoria objavljuje originalne radove iz svih oblasti filozofije.
			</p>
		</section>

		<section class="current">
			<p class="label">AKTUELNI BROJ</p>

			<h2>Vol. 69, No. 2 · 2026</h2>

			<p>Najnoviji broj časopisa Theoria.</p>

			<a class="button" href={`${base}aktuelni-broj/`}>
				Pogledaj sadržaj →
			</a>
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.intro {
		padding: 100px 0 90px;
		border-bottom: 1px solid #bcb7ac;
	}

	.label {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.17em;
		margin-bottom: 24px;
	}

	.intro h1 {
		max-width: 850px;
		font-size: clamp(3rem, 7vw, 6.5rem);
		line-height: 0.95;
		font-weight: 400;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.lead {
		max-width: 650px;
		margin: 36px 0 0;
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.current {
		padding: 70px 0 90px;
	}

	.current h2 {
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0 0 12px;
	}

	.current p {
		font-size: 1.1rem;
	}

	.button {
		display: inline-block;
		margin-top: 22px;
		padding: 12px 18px;
		border: 1px solid #181818;
		color: #181818;
		text-decoration: none;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	.button:hover {
		background: #181818;
		color: #f5f2eb;
	}

	@media (max-width: 800px) {
		.intro {
			padding: 65px 0;
		}
	}
</style>