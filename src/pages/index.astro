		background: #f5f2eb;
		color: #181818;
		font-family: Georgia, "Times New Roman", serif;
	}

	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	header {
		border-bottom: 1px solid #bcb7ac;
		padding: 32px 0 22px;
	}

	header .container {
