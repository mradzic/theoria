---
import BaseLayout from "../layouts/BaseLayout.astro";
import { issues } from "../data/issues";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const current = issues[0];
---

<BaseLayout
	title="Theoria — Srpsko filozofsko društvo"
	description="Theoria — časopis Srpskog filozofskog društva"
>
	<main class="container">
		<section class="intro">
			<p class="label">THEORIA · BEOGRAD</p>

			<h1>
				Filozofski časopis<br />
				Srpskog filozofskog<br />
				društva
			</h1>

			<p class="lead">
				Theoria objavljuje originalne radove iz svih oblasti filozofije.
			</p>
		</section>

		<section
			class="current"
			aria-labelledby="current-issue-title"
		>
			<div class="current-heading">
				<p class="label">AKTUELNI BROJ</p>

				<p class="issue-year">
					{current.year}
				</p>
			</div>

			<div class="current-body">
				<div class="issue-identity">
					<h2 id="current-issue-title">
						Vol. {current.volume}
					</h2>

					<p class="issue-number">
						No. {current.number}
					</p>
				</div>

				<div class="current-copy">
					<p class="current-description">
						Najnoviji broj časopisa <em>Theoria</em>.
					</p>

					<a
						class="issue-link"
						href={`${base}aktuelni-broj/`}
					>
						<span>Pogledaj sadržaj</span>
						<span
							class="arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(
			var(--page-width),
			calc(100% - var(--page-padding))
		);
		margin-inline: auto;
	}

	/* HERO */

	.intro {
		padding: 100px 0 90px;
		border-bottom: 1px solid var(--rule);
	}

	.label {
		margin: 0;

		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.17em;
	}

	.intro .label {
		margin-bottom: 24px;
	}

	.intro h1 {
		max-width: 900px;
		margin: 0;

		font-size: clamp(3.1rem, 7vw, 6.5rem);
		font-weight: 400;
		line-height: 0.95;

		letter-spacing: -0.025em;

		font-variant-ligatures: none;
		font-feature-settings:
			"liga" 0,
			"clig" 0;
	}

	.lead {
		max-width: 650px;
		margin: 36px 0 0;

		font-size: 1.35rem;
		line-height: 1.55;
	}

	/* CURRENT ISSUE */

	.current {
		padding-bottom: 96px;
	}

	.current-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;

		padding: 22px 0 20px;

		border-bottom: 1px solid var(--rule);
	}

	.issue-year {
		margin: 0;

		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.12em;
	}

	.current-body {
		display: grid;
		grid-template-columns:
			minmax(0, 1.7fr)
			minmax(250px, 0.7fr);

		gap: clamp(50px, 8vw, 110px);

		padding-top: 48px;
	}

	.issue-identity h2 {
		margin: 0;

		font-size: clamp(4rem, 8vw, 7.2rem);
		font-weight: 400;
		line-height: 0.88;

		letter-spacing: -0.045em;

		font-variant-numeric: lining-nums;
	}

	.issue-number {
		margin: 22px 0 0;

		font-size: clamp(1.6rem, 2.7vw, 2.25rem);
		font-weight: 400;
		line-height: 1;

		letter-spacing: -0.015em;

		font-variant-numeric: lining-nums;
	}

	.current-copy {
		align-self: end;

		max-width: 330px;
		padding-bottom: 7px;
	}

	.current-description {
		margin: 0 0 28px;

		font-size: 1.1rem;
		line-height: 1.55;
	}

	.issue-link {
		display: inline-flex;
		align-items: baseline;
		gap: 14px;

		padding-bottom: 5px;

		border-bottom: 1px solid currentColor;

		color: inherit;
		text-decoration: none;

		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.2;

		letter-spacing: 0.075em;
		text-transform: uppercase;
	}

	.issue-link:hover {
		opacity: 0.58;
	}

	.arrow {
		font-size: 1rem;
		font-weight: 400;
		line-height: 1;
	}

	/* TABLET */

	@media (max-width: 800px) {
		.intro {
			padding: 70px 0 68px;
		}

		.current-body {
			gap: 45px;
		}
	}

	/* MOBILE */

	@media (max-width: 620px) {
		.intro {
			padding: 58px 0 56px;
		}

		.intro .label {
			margin-bottom: 20px;
		}

		.lead {
			margin-top: 30px;

			font-size: 1.15rem;
		}

		.current {
			padding-bottom: 72px;
		}

		.current-heading {
			padding: 18px 0 17px;
		}

		.current-body {
			grid-template-columns: 1fr;
			gap: 44px;

			padding-top: 38px;
		}

		.issue-identity h2 {
			font-size: clamp(4rem, 20vw, 5.8rem);
		}

		.issue-number {
			margin-top: 17px;
		}

		.current-copy {
			max-width: 360px;
			padding-bottom: 0;
		}
	}
</style>