		font-weight: 400;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.lead {
		max-width: 650px;
		margin: 36px 0 0;
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.current {
		padding: 70px 0 90px;
	}

	.current h3 {
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0 0 12px;
	}

