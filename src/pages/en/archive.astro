---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { issues } from "../../data/issues";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const internalIssues = issues.map((issue) => ({
	year: issue.year,
	volume: issue.volume,
	number: issue.number,
	href: `${base}brojevi/${issue.slug}/`,
}));

const years = [...new Set(internalIssues.map((issue) => issue.year))]
	.sort((a, b) => b - a)
	.map((year) => {
		const yearIssues = internalIssues.filter(
			(issue) => issue.year === year,
		);

		return {
			year,
			volume: yearIssues[0].volume,
			issues: yearIssues,
		};
	});
---

<BaseLayout
	title="Archive — Theoria"
	description="Archive of Theoria, journal of the Serbian Philosophical Society"
	lang="en"
>
	<main class="container">
		<section class="heading">
			<p class="label">THEORIA</p>
			<h1>Archive</h1>

			<p class="intro">
				Published issues of <em>Theoria</em>.
			</p>
		</section>

		<section class="archive">
			{
				years.map((entry) => (
					<div class="year-block">
						<div class="year-heading">
							<h2>{entry.year}</h2>
							<p>Vol. {entry.volume}</p>
						</div>

						<div class="issues">
							{entry.issues.map((issue) => (
								<div class="issue">
									<div class="issue-name">
										<span>No. {issue.number}</span>
										<span class="citation">
											{entry.volume}({issue.number}), {entry.year}
										</span>
									</div>

									<a href={issue.href}>
										Contents →
									</a>
								</div>
							))}
						</div>
					</div>
				))
			}
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.heading {
		padding: 90px 0 70px;
		border-bottom: 1px solid #bcb7ac;
	}

	.label {
		margin: 0 0 24px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	.heading h1 {
		margin: 0;
		font-size: clamp(4rem, 9vw, 7rem);
		line-height: 0.95;
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.intro {
		margin: 32px 0 0;
		font-size: 1.25rem;
	}

	.archive {
		padding: 30px 0 100px;
	}

	.year-block {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 60px;
		padding: 55px 0;
		border-bottom: 1px solid #bcb7ac;
	}

	.year-heading h2 {
		margin: 0;
		font-size: 3rem;
		font-weight: 400;
	}

	.year-heading p {
		margin: 8px 0 0;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
	}

	.issues {
		border-top: 1px solid #c9c4ba;
	}

	.issue {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 22px 0;
		border-bottom: 1px solid #c9c4ba;
	}

	.issue-name {
		display: flex;
		align-items: baseline;
		gap: 22px;
	}

	.issue-name > span:first-child {
		font-size: 1.35rem;
	}

	.citation {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.76rem;
	}

	.issue a {
		color: inherit;
		text-decoration: none;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.78rem;
		border-bottom: 1px solid #181818;
	}

	@media (max-width: 700px) {
		.heading {
			padding: 60px 0 50px;
		}

		.year-block {
			grid-template-columns: 1fr;
			gap: 25px;
		}

		.issue-name {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
