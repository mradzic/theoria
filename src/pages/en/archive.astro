---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { issues } from "../../data/issues";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const internalIssues = issues.map((issue) => ({
	year: issue.year,
	volume: issue.volume,
	number: issue.number,
	href: `${base}en/issues/${issue.slug}/`,
}));

const years = [...new Set(internalIssues.map((issue) => issue.year))]
	.sort((a, b) => b - a)
	.map((year) => {
		const yearIssues = internalIssues.filter(
			(issue) => issue.year === year,
		);

		return {
			year,
			volume: yearIssues[0].volume,
			issues: yearIssues,
		};
	});
---

<BaseLayout
	title="Archive — Theoria"
	description="Archive of Theoria, journal of the Serbian Philosophical Society"
	lang="en"
>
	<main class="container">
		<section class="heading">
			<p class="label">THEORIA · ARCHIVE</p>

			<h1>Archive</h1>

			<p class="intro">
				Published issues of <em>Theoria</em>.
			</p>
		</section>

		<section class="archive" aria-label="Published issues">
			{
				years.map((entry) => (
					<section
						class="year-block"
						aria-labelledby={`year-${entry.year}`}
					>
						<header class="year-heading">
							<h2 id={`year-${entry.year}`}>
								{entry.year}
							</h2>

							<p class="volume">
								Vol. {entry.volume}
							</p>
						</header>

						<div class="issues">
							{entry.issues.map((issue) => (
								<div class="issue">
									<div class="issue-name">
										<p class="issue-number">
											No. {issue.number}
										</p>

										<p class="citation">
											{entry.volume}({issue.number}), {entry.year}
										</p>
									</div>

									<a
										class="issue-link"
										href={issue.href}
									>
										<span>Contents</span>

										<span
											class="arrow"
											aria-hidden="true"
										>
											→
										</span>
									</a>
								</div>
							))}
						</div>
					</section>
				))
			}
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(
			var(--page-width),
			calc(100% - var(--page-padding))
		);
		margin-inline: auto;
	}

	/* PAGE HEADING */

	.heading {
		padding: 90px 0 72px;
		border-bottom: 1px solid var(--rule);
	}

	.label {
		margin: 0 0 25px;

		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.17em;
	}

	.heading h1 {
		margin: 0;

		font-size: clamp(4.3rem, 9vw, 7.4rem);
		font-weight: 400;
		line-height: 0.9;

		letter-spacing: -0.045em;

		font-variant-ligatures: none;
		font-feature-settings:
			"liga" 0,
			"clig" 0;
	}

	.intro {
		max-width: 620px;

		margin: 36px 0 0;

		font-size: 1.22rem;
		line-height: 1.55;
	}

	/* ARCHIVE */

	.archive {
		padding: 0 0 105px;
	}

	.year-block {
		display: grid;
		grid-template-columns:
			minmax(180px, 0.48fr)
			minmax(0, 1.52fr);

		gap: clamp(48px, 8vw, 110px);

		padding: 58px 0 64px;

		border-bottom: 1px solid var(--rule);
	}

	.year-heading {
		align-self: start;
	}

	.year-heading h2 {
		margin: 0;

		font-size: clamp(3.25rem, 5.4vw, 4.8rem);
		font-weight: 400;
		line-height: 0.9;

		letter-spacing: -0.035em;

		font-variant-numeric: lining-nums tabular-nums;
	}

	.volume {
		margin: 17px 0 0;

		color: var(--muted);

		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.105em;
		text-transform: uppercase;

		font-variant-numeric: lining-nums tabular-nums;
	}

	/* ISSUES */

	.issues {
		border-top: 1px solid var(--rule);
	}

	.issue {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;

		align-items: center;
		gap: 40px;

		min-height: 92px;

		padding: 21px 0;

		border-bottom: 1px solid var(--rule-light);
	}

	.issue:last-child {
		border-bottom: 0;
	}

	.issue-name {
		display: flex;
		align-items: baseline;
		gap: 30px;

		min-width: 0;
	}

	.issue-number {
		flex: 0 0 auto;

		margin: 0;

		font-size: 1.55rem;
		font-weight: 400;
		line-height: 1.15;

		letter-spacing: -0.012em;

		font-variant-numeric: lining-nums tabular-nums;
	}

	.citation {
		margin: 0;

		color: var(--muted);

		font-family: var(--sans);
		font-size: 0.74rem;
		line-height: 1.4;

		letter-spacing: 0.025em;

		font-variant-numeric: lining-nums tabular-nums;
	}

	.issue-link {
		display: inline-flex;
		align-items: baseline;
		gap: 13px;

		padding-bottom: 4px;

		border-bottom: 1px solid currentColor;

		color: inherit;
		text-decoration: none;

		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.2;

		letter-spacing: 0.07em;
		text-transform: uppercase;

		white-space: nowrap;
	}

	.issue-link:hover {
		opacity: 0.58;
	}

	.arrow {
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1;
	}

	/* TABLET */

	@media (max-width: 800px) {
		.heading {
			padding: 68px 0 58px;
		}

		.year-block {
			grid-template-columns: 170px minmax(0, 1fr);

			gap: 45px;

			padding: 48px 0 54px;
		}

		.issue-name {
			gap: 22px;
		}
	}

	/* MOBILE */

	@media (max-width: 620px) {
		.heading {
			padding: 54px 0 52px;
		}

		.label {
			margin-bottom: 21px;
		}

		.heading h1 {
			font-size: clamp(4rem, 20vw, 5.7rem);
		}

		.intro {
			margin-top: 30px;

			font-size: 1.1rem;
		}

		.archive {
			padding-bottom: 72px;
		}

		.year-block {
			grid-template-columns: 1fr;
			gap: 31px;

			padding: 44px 0 49px;
		}

		.year-heading {
			display: flex;
			align-items: baseline;
			justify-content: space-between;

			gap: 25px;
		}

		.year-heading h2 {
			font-size: 3.65rem;
		}

		.volume {
			margin: 0;
		}

		.issue {
			grid-template-columns: 1fr auto;

			gap: 22px;

			min-height: 0;

			padding: 20px 0;
		}

		.issue-name {
			flex-direction: column;
			align-items: flex-start;

			gap: 7px;
		}

		.issue-number {
			font-size: 1.4rem;
		}

		.issue-link {
			font-size: 0.68rem;
		}
	}

	@media (max-width: 400px) {
		.issue {
			grid-template-columns: 1fr;
			gap: 17px;
		}

		.issue-link {
			justify-self: start;
		}
	}
</style>