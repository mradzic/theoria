<BaseLayout
	title="About — Theoria"
	description="About Theoria, journal of the Serbian Philosophical Society"
	lang="en"
>
	<main class="editorial-page">
		<section class="heading">
			<p class="label">THEORIA</p>
			<h1>About</h1>

			<p class="lead">
				<em>Theoria</em> is the philosophical journal of the Serbian
				Philosophical Society, publishing original scholarly work
				across philosophical fields and traditions.
			</p>
		</section>

		<section class="identifiers">
			<div>
				<p class="label">ISSN · PRINT</p>
				<p class="value">0351-2274</p>
			</div>

			<div>
				<p class="label">ISSN · ONLINE</p>
				<p class="value">2406-081X</p>
			</div>

			<div>
				<p class="label">COBISS.SR-ID</p>
				<p class="value">556303</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">AIMS &amp; SCOPE</p>
			</div>

			<div class="prose">
				<h2>Aims &amp; Scope</h2>

				<p>
					<em>Theoria</em> is a general philosophy journal published
					by the Serbian Philosophical Society. It publishes
					original research articles, discussions, critical studies
					and reviews from all areas of philosophy, with particular
					interest in logic, philosophy of language, epistemology,
					metaphysics, philosophy of science, ethics, political
					philosophy, history of philosophy and related
					interdisciplinary fields.
				</p>

				<p>
					The journal welcomes contributions from authors in Serbia
					and abroad and seeks to advance philosophically rigorous
					work of international scholarly relevance.
				</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">PUBLISHER</p>
			</div>

			<div class="prose">
