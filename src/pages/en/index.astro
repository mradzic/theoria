---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { issues } from "../../data/issues";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const current = issues[0];
---

<BaseLayout
	title="Theoria — Serbian Philosophical Society"
	description="Theoria, journal of the Serbian Philosophical Society"
	lang="en"
>
	<main class="container">
		<section class="intro">
			<p class="label">THEORIA · BELGRADE</p>

			<h1>
				Journal of<br />
				the Serbian<br />
				Philosophical Society
			</h1>

			<p class="lead">
				<em>Theoria</em> publishes original scholarly work from
				across the fields and traditions of philosophy.
			</p>
		</section>

		<section class="current">
			<p class="label">CURRENT ISSUE</p>

			<h2>
				Vol. {current.volume}, No. {current.number} · {current.year}
			</h2>

			<p>The latest issue of <em>Theoria</em>.</p>

			<a class="button" href={`${base}en/current-issue/`}>
				View contents →
			</a>
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.intro {
		padding: 100px 0 90px;
		border-bottom: 1px solid #bcb7ac;
	}

	.label {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.17em;
		margin-bottom: 24px;
	}

	.intro h1 {
		max-width: 900px;
		font-size: clamp(3rem, 7vw, 6.5rem);
		line-height: 0.95;
		font-weight: 400;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.lead {
		max-width: 680px;
		margin: 36px 0 0;
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.current {
		padding: 70px 0 90px;
	}

	.current h2 {
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0 0 12px;
	}

	.current p {
		font-size: 1.1rem;
	}

	.button {
		display: inline-block;
		margin-top: 22px;
		padding: 12px 18px;
		border: 1px solid #181818;
		color: #181818;
		text-decoration: none;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	.button:hover {
		background: #181818;
		color: #f5f2eb;
	}

	@media (max-width: 800px) {
		.intro {
			padding: 65px 0;
		}
	}
</style>