---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="For authors — Theoria"
	description="Instructions for authors submitting to Theoria"
	lang="en"
>
	<main class="container">
		<section class="heading">
			<p class="label">THEORIA</p>

			<h1>For authors</h1>

			<p class="lead">
				Instructions for preparing and submitting manuscripts to
				<em>Theoria</em>.
			</p>
		</section>

		<section class="facts">
			<div>
				<p class="label">LENGTH</p>
				<p class="value">up to 35,000 characters</p>
				<p class="small">including spaces</p>
			</div>

			<div>
				<p class="label">LANGUAGES</p>
				<p class="value">Serbian · English</p>
				<p class="small">Serbian texts are published in Latin script</p>
			</div>

			<div>
				<p class="label">REVIEW</p>
				<p class="value">double-blind</p>
				<p class="small">at least two reviewers</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">SUBMISSION</p>
			</div>

			<div class="prose">
				<h2>Manuscripts are submitted electronically.</h2>

				<p>
					Submit a Microsoft Word document
					(<code>.doc</code> or <code>.docx</code>) to the
					Editorial Office:
				</p>

				<p>
					<a class="email" href="mailto:theoria.redakcija@gmail.com">
						theoria.redakcija@gmail.com
					</a>
				</p>

				<p>
					<em>Theoria</em> is published four times a year, in
					March, June, September and December.
				</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">MANUSCRIPT</p>
			</div>

			<div class="prose">
				<h2>Technical requirements</h2>

				<ul>
					<li>Times New Roman, 12 pt.</li>
					<li>1.5 line spacing.</li>
					<li>No page numbering.</li>
					<li>The title should be written in capital letters.</li>
					<li>
						The author's first and last name should appear
						before the title.
					</li>
					<li>Abstract: 80–150 words.</li>
					<li>Keywords: 3–8.</li>
					<li>Footnotes rather than endnotes.</li>
					<li>
						Italics should be used for emphasis rather than
						bold type, except in headings and subheadings.
					</li>
				</ul>

				<h2>Language requirements</h2>

				<p>
					A Serbian-language paper must conclude, after the
					bibliography, with the author's name, title of the
					paper, summary and keywords in English.
				</p>

				<p>
					An English-language paper must provide the corresponding
					information in Serbian.
				</p>

				<p>
					The maximum length of a submission is 1.5 author's
					sheets, or 35,000 characters including spaces.
				</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">REFERENCES</p>
			</div>

			<div class="prose">
				<h2>Citation style</h2>

				<p>
					In-text references use the author–date system:
					<code>(Author year: page)</code>.
				</p>

				<div class="example">
					<p class="example-label">BOOK</p>

					<p>
						Jorati, Julia (2017).
						<em>Leibniz on Causation and Agency</em>
						(Cambridge: Cambridge University Press).
					</p>

					<p class="citation">
						(Jorati 2017: 43)
					</p>
				</div>

				<div class="example">
					<p class="example-label">JOURNAL ARTICLE</p>

					<p>
						Tsouna, Voula (2016). “Epicurean Preconceptions,”
						<em>Phronesis</em> 61: 160–221.
					</p>

					<p class="citation">
						(Tsouna 2016: 169)
					</p>
				</div>

				<div class="example">
					<p class="example-label">CHAPTER IN AN EDITED VOLUME</p>

					<p>
						Bennett, Jonathan (1996). “Spinoza's Metaphysics,”
						in Don Garrett (ed.),
						<em>The Cambridge Companion to Spinoza</em>
						(Cambridge: Cambridge University Press): 61–88.
					</p>

					<p class="citation">
						(Bennett 1996: 87)
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">PEER REVIEW</p>
			</div>

			<div class="prose">
				<h2>Double-blind peer review</h2>

				<p>
					Each manuscript that passes the initial editorial
					assessment is reviewed by at least two independent
					experts.
				</p>

				<p>
					Reviewers do not know the identity of the authors,
					and authors do not know the identity of the reviewers.
				</p>

				<p>
					Under normal circumstances the review process takes
					up to four weeks. In technically demanding cases it
					may take up to three months.
				</p>

				<p>
					The final decision on acceptance or rejection is made
					by the Editor-in-Chief.
				</p>
			</div>
		</section>

		<section class="section">
			<div>
				<p class="label">PUBLICATION ETHICS</p>
			</div>

			<div class="prose">
				<h2>Authors' responsibilities</h2>

				<p>
					By submitting a manuscript, authors confirm that the
					work is original, has not previously been published
					and is not simultaneously under consideration
					elsewhere.
				</p>

				<p>
					All sources must be properly acknowledged. Authors
					must disclose any financial or other relevant conflict
					of interest.
				</p>

				<p>
					<em>Theoria</em> does not publish plagiarised work.
					The Editorial Board follows the principles and
					guidelines of the Committee on Publication Ethics
					(COPE) when dealing with breaches of publication
					ethics.
				</p>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	.heading {
		padding: 90px 0 70px;
		border-bottom: 1px solid #bcb7ac;
	}

	.label {
		margin: 0 0 22px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 9vw, 7rem);
		line-height: 0.95;
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.lead {
		max-width: 760px;
		margin: 35px 0 0;
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-bottom: 1px solid #bcb7ac;
	}

	.facts > div {
		padding: 36px 30px 36px 0;
	}

	.facts > div + div {
		padding-left: 30px;
		border-left: 1px solid #bcb7ac;
	}

	.facts .label {
		margin-bottom: 12px;
	}

	.value {
		margin: 0;
		font-size: 1.35rem;
	}

	.small {
		margin: 7px 0 0;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.78rem;
	}

	.section {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 60px;
		padding: 65px 0;
		border-bottom: 1px solid #bcb7ac;
	}

	.prose {
		max-width: 760px;
	}

	.prose h2 {
		margin: 0 0 24px;
		font-size: 2rem;
		font-weight: 400;
	}

	.prose h2:not(:first-child) {
		margin-top: 45px;
	}

	.prose p,
	.prose li {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.prose ul {
		padding-left: 22px;
	}

	.prose li {
		margin-bottom: 8px;
	}

	.prose a {
		color: inherit;
	}

	.email {
		font-size: 1.3rem;
	}

	code {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 0.9em;
	}

	.example {
		padding: 26px 0;
		border-top: 1px solid #c9c4ba;
	}

	.example:last-child {
		border-bottom: 1px solid #c9c4ba;
	}

	.example p {
		margin: 0;
	}

	.example-label {
		margin-bottom: 12px !important;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem !important;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.citation {
		margin-top: 10px !important;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem !important;
	}

	@media (max-width: 800px) {
		.heading {
			padding: 60px 0 50px;
		}

		.facts {
			grid-template-columns: 1fr;
		}

		.facts > div,
		.facts > div + div {
			padding: 28px 0;
			border-left: 0;
			border-bottom: 1px solid #bcb7ac;
		}

		.section {
			grid-template-columns: 1fr;
			gap: 25px;
		}
	}
</style>