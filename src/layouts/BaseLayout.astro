---
interface Props {
	title: string;
	description?: string;
	lang?: "sr" | "en";
}

const {
	title,
	description,
	lang = "sr",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;

const base = rawBase.endsWith("/")
	? rawBase
	: `${rawBase}/`;

const isEnglish = lang === "en";

const resolvedDescription =
	description ??
	(isEnglish
		? "Theoria — journal of the Serbian Philosophical Society"
		: "Theoria — časopis Srpskog filozofskog društva");

const homeHref = isEnglish
	? `${base}en/`
	: base;

const nav = isEnglish
	? [
			{
				label: "Home",
				href: `${base}en/`,
			},
			{
				label: "Current issue",
				href: `${base}en/current-issue/`,
			},
			{
				label: "Archive",
				href: `${base}en/archive/`,
			},
			{
				label: "About",
				href: `${base}en/about/`,
			},
			{
				label: "For authors",
				href: `${base}en/for-authors/`,
			},
		]
	: [
			{
				label: "Početna",
				href: base,
			},
			{
				label: "Aktuelni broj",
				href: `${base}aktuelni-broj/`,
			},
			{
				label: "Arhiva",
				href: `${base}arhiva/`,
			},
			{
				label: "O časopisu",
				href: `${base}o-casopisu/`,
			},
			{
				label: "Za autore",
				href: `${base}uputstvo-autorima/`,
			},
		];

/*
 * Određivanje odgovarajuće stranice na drugom jeziku.
 */

const pathname = Astro.url.pathname;

let relativePath = pathname.startsWith(base)
	? pathname.slice(base.length)
	: pathname.replace(/^\/+/, "");

if (
	relativePath !== "" &&
	!relativePath.endsWith("/")
) {
	relativePath += "/";
}

let languageHref;

if (isEnglish) {
	if (relativePath === "en/") {
		languageHref = base;
	} else if (
		relativePath === "en/current-issue/"
	) {
		languageHref = `${base}aktuelni-broj/`;
	} else if (
		relativePath === "en/archive/"
	) {
		languageHref = `${base}arhiva/`;
	} else if (
		relativePath === "en/about/"
	) {
		languageHref = `${base}o-casopisu/`;
	} else if (
		relativePath === "en/for-authors/"
	) {
		languageHref =
			`${base}uputstvo-autorima/`;
	} else if (
		relativePath.startsWith("en/issues/")
	) {
		const slug = relativePath.slice(
			"en/issues/".length,
		);

		languageHref =
			`${base}brojevi/${slug}`;
	} else {
		languageHref = base;
	}
} else {
	if (relativePath === "") {
		languageHref = `${base}en/`;
	} else if (
		relativePath === "aktuelni-broj/"
	) {
		languageHref =
			`${base}en/current-issue/`;
	} else if (
		relativePath === "arhiva/"
	) {
		languageHref =
			`${base}en/archive/`;
	} else if (
		relativePath === "o-casopisu/"
	) {
		languageHref =
			`${base}en/about/`;
	} else if (
		relativePath === "uputstvo-autorima/"
	) {
		languageHref =
			`${base}en/for-authors/`;
	} else if (
		relativePath.startsWith("brojevi/")
	) {
		const slug = relativePath.slice(
			"brojevi/".length,
		);

		languageHref =
			`${base}en/issues/${slug}`;
	} else {
		languageHref = `${base}en/`;
	}
}

const languageLabel = isEnglish
	? "SR"
	: "EN";

/*
 * SEO.
 *
 * Za sada Astro.site pokazuje na GitHub Pages.
 * Kada konačno prebacimo theoria.rs, biće dovoljno
 * promeniti site/base u astro.config.mjs.
 */

const siteOrigin =
	Astro.site ?? Astro.url.origin;

const canonicalURL = new URL(
	Astro.url.pathname,
	siteOrigin,
);

const ogImageURL = new URL(
	`${base}theoria_og_1200x630.png`,
	siteOrigin,
);

const locale = isEnglish
	? "en_US"
	: "sr_RS";

const alternateLocale = isEnglish
	? "sr_RS"
	: "en_US";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>{title}</title>

		<meta
			name="description"
			content={resolvedDescription}
		/>

		<meta
			name="robots"
			content="index, follow"
		/>

		<meta
			name="theme-color"
			content="#f5f2eb"
		/>

		<link
			rel="canonical"
			href={canonicalURL}
		/>

		<!-- Favicons -->

		<link
			rel="icon"
			href={`${base}favicon.ico`}
			sizes="any"
		/>

		<link
			rel="icon"
			type="image/svg+xml"
			href={`${base}favicon.svg`}
		/>

		<link
			rel="icon"
			type="image/png"
			sizes="96x96"
			href={`${base}favicon-96x96.png`}
		/>

		<link
			rel="apple-touch-icon"
			href={`${base}apple-touch-icon.png`}
		/>

		<link
			rel="manifest"
			href={`${base}site.webmanifest`}
		/>

		<!-- Open Graph -->

		<meta
			property="og:type"
			content="website"
		/>

		<meta
			property="og:site_name"
			content="Theoria"
		/>

		<meta
			property="og:title"
			content={title}
		/>

		<meta
			property="og:description"
			content={resolvedDescription}
		/>

		<meta
			property="og:url"
			content={canonicalURL}
		/>

		<meta
			property="og:image"
			content={ogImageURL}
		/>

		<meta
			property="og:image:width"
			content="1200"
		/>

		<meta
			property="og:image:height"
			content="630"
		/>

		<meta
			property="og:image:alt"
			content="Theoria — Serbian Philosophical Society"
		/>

		<meta
			property="og:locale"
			content={locale}
		/>

		<meta
			property="og:locale:alternate"
			content={alternateLocale}
		/>

		<!-- X / Twitter -->

		<meta
			name="twitter:card"
			content="summary_large_image"
		/>

		<meta
			name="twitter:title"
			content={title}
		/>

		<meta
			name="twitter:description"
			content={resolvedDescription}
		/>

		<meta
			name="twitter:image"
			content={ogImageURL}
		/>
	</head>

	<body>
		<header>
			<div class="site-container header-inner">
				<div class="brand">
					<a href={homeHref}>
						THEORIA
					</a>

					<p>
						{
							isEnglish
								? "Journal of the Serbian Philosophical Society"
								: "Časopis Srpskog filozofskog društva"
						}
					</p>
				</div>

				<div class="navigation">
					<nav
						aria-label={
							isEnglish
								? "Main navigation"
								: "Glavna navigacija"
						}
					>
						{
							nav.map((item) => (
								<a href={item.href}>
									{item.label}
								</a>
							))
						}
					</nav>

					<a
						class="language"
						href={languageHref}
						lang={isEnglish ? "sr" : "en"}
						aria-label={
							isEnglish
								? "Srpska verzija"
								: "English version"
						}
					>
						{languageLabel}
					</a>
				</div>
			</div>
		</header>

		<slot />

		<footer>
			<div class="site-container">
				<p>
					{
						isEnglish
							? "THEORIA · Serbian Philosophical Society · Belgrade"
							: "THEORIA · Srpsko filozofsko društvo · Beograd"
					}
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f5f2eb;
	}

	:global(body) {
		margin: 0;
		background: #f5f2eb;
		color: #181818;
		font-family: Georgia, "Times New Roman", serif;
	}

	.site-container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	header {
		border-bottom: 1px solid #bcb7ac;
		padding: 32px 0 22px;
	}

	.header-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.brand > a {
		color: inherit;
		text-decoration: none;
		font-size: 3rem;
		font-weight: 400;
		letter-spacing: 0.12em;
	}

	.brand p {
		margin: 5px 0 0;
		font-size: 0.95rem;
	}

	.navigation {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	nav a,
	.language {
		color: inherit;
		text-decoration: none;
	}

	nav a:hover,
	.language:hover {
		text-decoration: underline;
	}

	.language {
		padding-left: 20px;
		border-left: 1px solid #bcb7ac;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	footer {
		border-top: 1px solid #bcb7ac;
		padding: 28px 0;
		font-size: 0.85rem;
	}

	@media (max-width: 800px) {
		.header-inner {
			align-items: flex-start;
			flex-direction: column;
		}

		.navigation {
			align-items: flex-start;
			flex-direction: column;
			gap: 14px;
		}

		nav {
			gap: 16px;
		}

		.language {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>