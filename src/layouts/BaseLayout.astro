---
interface Props {
	title: string;
	description?: string;
	lang?: "sr" | "en";
}

const {
	title,
	description,
	lang = "sr",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;

const base = rawBase.endsWith("/")
	? rawBase
	: `${rawBase}/`;

const isEnglish = lang === "en";

const resolvedDescription =
	description ??
	(isEnglish
		? "Theoria — journal of the Serbian Philosophical Society"
		: "Theoria — časopis Srpskog filozofskog društva");

const homeHref = isEnglish
	? `${base}en/`
	: base;

const nav = isEnglish
	? [
			{ label: "Home", href: `${base}en/` },
			{ label: "Current issue", href: `${base}en/current-issue/` },
			{ label: "Archive", href: `${base}en/archive/` },
			{ label: "About", href: `${base}en/about/` },
			{ label: "For authors", href: `${base}en/for-authors/` },
		]
	: [
			{ label: "Početna", href: base },
			{ label: "Aktuelni broj", href: `${base}aktuelni-broj/` },
			{ label: "Arhiva", href: `${base}arhiva/` },
			{ label: "O časopisu", href: `${base}o-casopisu/` },
			{ label: "Za autore", href: `${base}uputstvo-autorima/` },
		];

const pathname = Astro.url.pathname;

let relativePath = pathname.startsWith(base)
	? pathname.slice(base.length)
	: pathname.replace(/^\/+/, "");

if (
	relativePath !== "" &&
	!relativePath.endsWith("/")
) {
	relativePath += "/";
}

let languageHref;

if (isEnglish) {
	if (relativePath === "en/") {
		languageHref = base;
	} else if (
		relativePath === "en/current-issue/"
	) {
		languageHref = `${base}aktuelni-broj/`;
	} else if (
		relativePath === "en/archive/"
	) {
		languageHref = `${base}arhiva/`;
	} else if (
		relativePath === "en/about/"
	) {
		languageHref = `${base}o-casopisu/`;
	} else if (
		relativePath === "en/for-authors/"
	) {
		languageHref =
			`${base}uputstvo-autorima/`;
	} else if (
		relativePath.startsWith("en/issues/")
	) {
		const slug = relativePath.slice(
			"en/issues/".length,
		);

		languageHref =
			`${base}brojevi/${slug}`;
	} else {
		languageHref = base;
	}
} else {
	if (relativePath === "") {
		languageHref = `${base}en/`;
	} else if (
		relativePath === "aktuelni-broj/"
	) {
		languageHref =
			`${base}en/current-issue/`;
	} else if (
		relativePath === "arhiva/"
	) {
		languageHref =
			`${base}en/archive/`;
	} else if (
		relativePath === "o-casopisu/"
	) {
		languageHref =
			`${base}en/about/`;
	} else if (
		relativePath === "uputstvo-autorima/"
	) {
		languageHref =
			`${base}en/for-authors/`;
	} else if (
		relativePath.startsWith("brojevi/")
	) {
		const slug = relativePath.slice(
			"brojevi/".length,
		);

		languageHref =
			`${base}en/issues/${slug}`;
	} else {
		languageHref = `${base}en/`;
	}
}

const languageLabel = isEnglish
	? "SR"
	: "EN";

const normalisePath = (value: string) => {
	const url = new URL(value, Astro.url.origin);
	return url.pathname.endsWith("/")
		? url.pathname
		: `${url.pathname}/`;
};

const currentPath = pathname.endsWith("/")
	? pathname
	: `${pathname}/`;

const isActive = (href: string) => {
	const target = normalisePath(href);

	if (target === base) {
		return currentPath === base;
	}

	if (target === `${base}en/`) {
		return currentPath === `${base}en/`;
	}

	return currentPath.startsWith(target);
};

/* SEO */

const siteOrigin =
	Astro.site ?? Astro.url.origin;

const canonicalURL = new URL(
	Astro.url.pathname,
	siteOrigin,
);

const ogImageURL = new URL(
	`${base}theoria_og_1200x630.png`,
	siteOrigin,
);

const locale = isEnglish
	? "en_US"
	: "sr_RS";

const alternateLocale = isEnglish
	? "sr_RS"
	: "en_US";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>{title}</title>

		<meta
			name="description"
			content={resolvedDescription}
		/>

		<meta
			name="robots"
			content="index, follow"
		/>

		<meta
			name="theme-color"
			content="#f3efe7"
		/>

		<link
			rel="canonical"
			href={canonicalURL}
		/>

		<link
			rel="icon"
			href={`${base}favicon.ico`}
			sizes="any"
		/>

		<link
			rel="icon"
			type="image/svg+xml"
			href={`${base}favicon.svg`}
		/>

		<link
			rel="icon"
			type="image/png"
			sizes="96x96"
			href={`${base}favicon-96x96.png`}
		/>

		<link
			rel="apple-touch-icon"
			href={`${base}apple-touch-icon.png`}
		/>

		<link
			rel="manifest"
			href={`${base}site.webmanifest`}
		/>

		<meta
			property="og:type"
			content="website"
		/>

		<meta
			property="og:site_name"
			content="Theoria"
		/>

		<meta
			property="og:title"
			content={title}
		/>

		<meta
			property="og:description"
			content={resolvedDescription}
		/>

		<meta
			property="og:url"
			content={canonicalURL}
		/>

		<meta
			property="og:image"
			content={ogImageURL}
		/>

		<meta
			property="og:image:width"
			content="1200"
		/>

		<meta
			property="og:image:height"
			content="630"
		/>

		<meta
			property="og:image:alt"
			content="Theoria — Serbian Philosophical Society"
		/>

		<meta
			property="og:locale"
			content={locale}
		/>

		<meta
			property="og:locale:alternate"
			content={alternateLocale}
		/>

		<meta
			name="twitter:card"
			content="summary_large_image"
		/>

		<meta
			name="twitter:title"
			content={title}
		/>

		<meta
			name="twitter:description"
			content={resolvedDescription}
		/>

		<meta
			name="twitter:image"
			content={ogImageURL}
		/>
	</head>

	<body>
		<header class="site-header">
			<div class="site-container header-inner">
				<div class="brand">
					<a class="wordmark" href={homeHref}>
						THEORIA
					</a>

					<p class="tagline">
						{
							isEnglish
								? "Journal of the Serbian Philosophical Society"
								: "Časopis Srpskog filozofskog društva"
						}
					</p>
				</div>

				<div class="navigation">
					<nav
						aria-label={
							isEnglish
								? "Main navigation"
								: "Glavna navigacija"
						}
					>
						{
							nav.map((item) => (
								<a
									href={item.href}
									class:list={[
										"nav-link",
										{ active: isActive(item.href) },
									]}
								>
									{item.label}
								</a>
							))
						}
					</nav>

					<a
						class="language"
						href={languageHref}
						lang={isEnglish ? "sr" : "en"}
						aria-label={
							isEnglish
								? "Srpska verzija"
								: "English version"
						}
					>
						{languageLabel}
					</a>
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="site-container footer-inner">
				<div>
					<p class="footer-name">
						THEORIA
					</p>

					<p class="footer-description">
						{
							isEnglish
								? "Serbian Philosophical Society · Belgrade"
								: "Srpsko filozofsko društvo · Beograd"
						}
					</p>
				</div>

				<div class="footer-meta">
					<p>ISSN 0351-2274</p>
					<p>eISSN 2406-081X</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(:root) {
		--paper: #f3efe7;
		--ink: #171715;
		--muted: #6f6a61;
		--rule: #bdb7ac;
		--rule-light: #cec8bd;

		--page-width: 1160px;
		--page-padding: 48px;

		--serif:
			Georgia,
			"Times New Roman",
			Times,
			serif;

		--sans:
			Arial,
			Helvetica,
			sans-serif;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--paper);
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--serif);
		font-kerning: normal;
		font-variant-ligatures:
			common-ligatures contextual;
		text-rendering: optimizeLegibility;
	}

	:global(a) {
		color: inherit;
	}

	:global(::selection) {
		background: var(--ink);
		color: var(--paper);
	}

	.site-container {
		width: min(
			var(--page-width),
			calc(100% - var(--page-padding))
		);

		margin-inline: auto;
	}

	/* HEADER */

	.site-header {
		border-bottom: 1px solid var(--rule);
	}

	.header-inner {
		min-height: 138px;

		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 64px;
	}

	.brand {
		flex: 0 0 auto;
	}

	.wordmark {
		display: inline-block;

		color: inherit;
		text-decoration: none;

		font-size: clamp(2.65rem, 4vw, 3.35rem);
		font-weight: 400;
		line-height: 0.95;

		letter-spacing: 0.145em;
	}

	.tagline {
		margin: 10px 0 0;

		color: var(--ink);

		font-size: 0.91rem;
		line-height: 1.2;
	}

	.navigation {
		display: flex;
		align-items: center;

		gap: 28px;
	}

	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;

		gap: 26px;

		font-family: var(--sans);
		font-size: 0.78rem;
	}

	.nav-link {
		position: relative;

		padding: 8px 0;

		color: inherit;
		text-decoration: none;

		white-space: nowrap;
	}

	.nav-link::after {
		content: "";

		position: absolute;
		left: 0;
		right: 0;
		bottom: 1px;

		height: 1px;

		background: currentColor;

		transform: scaleX(0);
		transform-origin: left;

		transition: transform 140ms ease;
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		transform: scaleX(1);
	}

	.language {
		flex: 0 0 auto;

		padding-left: 22px;

		border-left: 1px solid var(--rule);

		color: inherit;
		text-decoration: none;

		font-family: var(--sans);
		font-size: 0.67rem;
		font-weight: 700;

		letter-spacing: 0.16em;
	}

	.language:hover {
		opacity: 0.55;
	}

	/* FOOTER */

	.site-footer {
		margin-top: 20px;

		border-top: 1px solid var(--rule);

		padding: 42px 0 48px;
	}

	.footer-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		gap: 40px;
	}

	.footer-name {
		margin: 0;

		font-size: 1rem;
		letter-spacing: 0.15em;
	}

	.footer-description {
		margin: 9px 0 0;

		color: var(--muted);

		font-size: 0.83rem;
	}

	.footer-meta {
		display: flex;
		gap: 22px;

		color: var(--muted);

		font-family: var(--sans);
		font-size: 0.68rem;

		letter-spacing: 0.04em;
	}

	.footer-meta p {
		margin: 0;
	}

	/* TABLET */

	@media (max-width: 900px) {
		.header-inner {
			min-height: auto;

			padding: 30px 0 24px;

			align-items: flex-start;
			flex-direction: column;

			gap: 28px;
		}

		.navigation {
			width: 100%;

			justify-content: space-between;

			gap: 20px;
		}

		nav {
			gap: 20px;
		}
	}

	/* MOBILE */

	@media (max-width: 620px) {
		:global(:root) {
			--page-padding: 32px;
		}

		.wordmark {
			font-size: 2.45rem;
		}

		.tagline {
			font-size: 0.82rem;
		}

		.navigation {
			align-items: flex-start;
		}

		nav {
			display: grid;
			grid-template-columns: repeat(2, max-content);

			gap: 8px 22px;
		}

		.nav-link {
			padding: 4px 0;
		}

		.language {
			margin-top: 4px;

			padding-left: 16px;
		}

		.footer-inner {
			align-items: flex-start;
			flex-direction: column;

			gap: 25px;
		}

		.footer-meta {
			flex-direction: column;

			gap: 5px;
		}
	}
</style>