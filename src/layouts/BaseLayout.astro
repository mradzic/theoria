---
interface Props {
	title: string;
	description?: string;
	lang?: "sr" | "en";
}

const {
	title,
	description = "Theoria — časopis Srpskog filozofskog društva",
	lang = "sr",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const isEnglish = lang === "en";

const homeHref = isEnglish ? `${base}en/` : base;

const nav = isEnglish
	? [
			{ label: "Home", href: `${base}en/` },
			{ label: "Current issue", href: `${base}en/current-issue/` },
			{ label: "Archive", href: `${base}en/archive/` },
			{ label: "About", href: `${base}en/about/` },
			{ label: "For authors", href: `${base}en/for-authors/` },
		]
	: [
			{ label: "Početna", href: base },
			{ label: "Aktuelni broj", href: `${base}aktuelni-broj/` },
			{ label: "Arhiva", href: `${base}arhiva/` },
			{ label: "O časopisu", href: `${base}o-casopisu/` },
			{ label: "Za autore", href: `${base}uputstvo-autorima/` },
		];

const languageHref = isEnglish ? base : `${base}en/`;
const languageLabel = isEnglish ? "SR" : "EN";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />

		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

		<title>{title}</title>
	</head>

	<body>
		<header>
			<div class="site-container header-inner">
				<div class="brand">
					<a href={homeHref}>THEORIA</a>

					<p>
						{
							isEnglish
								? "Journal of the Serbian Philosophical Society"
								: "Časopis Srpskog filozofskog društva"
						}
					</p>
				</div>

				<div class="navigation">
					<nav aria-label={isEnglish ? "Main navigation" : "Glavna navigacija"}>
						{
							nav.map((item) => (
								<a href={item.href}>{item.label}</a>
							))
						}
					</nav>

					<a class="language" href={languageHref}>
						{languageLabel}
					</a>
				</div>
			</div>
		</header>

		<slot />

		<footer>
			<div class="site-container">
				<p>
					{
						isEnglish
							? "THEORIA · Serbian Philosophical Society · Belgrade"
							: "THEORIA · Srpsko filozofsko društvo · Beograd"
					}
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f5f2eb;
	}

	:global(body) {
		margin: 0;
		background: #f5f2eb;
		color: #181818;
		font-family: Georgia, "Times New Roman", serif;
	}

	.site-container {
		width: min(1120px, calc(100% - 48px));
		margin: 0 auto;
	}

	header {
		border-bottom: 1px solid #bcb7ac;
		padding: 32px 0 22px;
	}

	.header-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.brand > a {
		color: inherit;
		text-decoration: none;
		font-size: 3rem;
		font-weight: 400;
		letter-spacing: 0.12em;
	}

	.brand p {
		margin: 5px 0 0;
		font-size: 0.95rem;
	}

	.navigation {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	nav a,
	.language {
		color: inherit;
		text-decoration: none;
	}

	nav a:hover,
	.language:hover {
		text-decoration: underline;
	}

	.language {
		padding-left: 20px;
		border-left: 1px solid #bcb7ac;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	footer {
		border-top: 1px solid #bcb7ac;
		padding: 28px 0;
		font-size: 0.85rem;
	}

	@media (max-width: 800px) {
		.header-inner {
			align-items: flex-start;
			flex-direction: column;
		}

		.navigation {
			align-items: flex-start;
			flex-direction: column;
			gap: 14px;
		}

		.language {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>